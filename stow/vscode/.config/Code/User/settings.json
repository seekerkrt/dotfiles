{
    // Editor
    "editor.fontFamily": "MyricaM M",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    "editor.autoIndent": "full",
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,
    "editor.formatOnSave": true,
    "editor.acceptSuggestionOnEnter": "smart",
    "editor.suggestSelection": "first",
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.enableTrash": false,
    "files.exclude": {
        "**/.classpath": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.factorypath": true
    },
    "files.associations": {
        "*.cade": "cpp",
        "*.cadh": "cpp"
    },
    "breadcrumbs.enabled": true,
    "window.zoomLevel": 1,
    "workbench.settings.editor": "json",
    "workbench.iconTheme": "vscode-icons",
    "workbench.editor.empty.hint": "hidden",
    "workbench.editorAssociations": {
        "*.lnk": "default"
    },
    // Terminal
    "terminal.integrated.fontFamily": "JetBrains Mono, Noto Sans Mono CJK JP",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.lineHeight": 1.0,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.defaultProfile.windows": "Zsh",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [
                "/k",
                "chcp",
                "65001"
            ],
            "icon": "terminal-cmd"
        },
        "Zsh": {
            "path": "C:\\msys64\\usr\\bin\\zsh.exe",
            "args": [
                "--login"
            ],
            "env": {
                "MSYSTEM": "MINGW64",
                "CHERE_INVOKING": "1"
            },
            "icon": "terminal-linux"
        }
    },
    "terminal.integrated.env.windows": {
        "MSYSTEM": "MINGW64",
        "CHERE_INVOKING": "1"
    },
    "C_Cpp.clang_format_path": "/usr/bin/clang-format",
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.default.compilerPath": "/usr/bin/g++",
    // C/C++ Language Server
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--query-driver=/usr/bin/x86_64-elf-g++,/usr/bin/x86_64-elf-gcc,/usr/bin/x86_64-w64-mingw32-g++,/usr/bin/x86_64-w64-mingw32-gcc",
        "--clang-tidy=false"
    ],
    "cmake.configureOnOpen": true,
    "makefile.configureOnOpen": true,
    "todo-tree.highlights.enabled": true,
    "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
    "git.useIntegratedAskPass": false,
    "git.ignoreMissingGitWarning": true,
    "git.openRepositoryInParentFolders": "never",
    "html.format.endWithNewline": true,
    "markdown.preview.breaks": true,
    "markdownlint.configFile": "${userHome}/.markdownlint.json",
    "pasteImage.path": "${currentFileDir}/images/${currentFileNameWithoutExt}",
    "pasteImage.namePrefix": "img-",
    // C/C++ Formatter
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    // Markdown
    "[markdown]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "on",
            "other": "on"
        },
        "editor.formatOnSave": true,
        "editor.renderWhitespace": "selection",
        "files.trimTrailingWhitespace": false
    },
    "[mdx]": {
        "editor.wordWrap": "on"
    },
    // GitHub Copilot / Agent customizations
    "editor.inlineSuggest.enabled": true,
    "github.copilot.enable": {
        "*": true
    },
    // Go
    "go.alternateTools": {
        "gopls": "/usr/bin/gopls"
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false
    },
    // Python
    "python.defaultInterpreterPath": "/usr/bin/python",
    "python.analysis.typeCheckingMode": "basic",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    // Ruby
    "[ruby]": {
        "editor.defaultFormatter": "Shopify.ruby-lsp",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    "rubyLsp.formatter": "auto",
    "rubyLsp.rubyVersionManager": {
        "identifier": "none"
    },
    // Shell Script
    "[shellscript]": {
        "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode",
        "editor.formatOnSave": true
    },
    "shellcheck.enable": true,
    "shellcheck.run": "onType",
    // Rust
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    "rust-analyzer.check.command": "clippy",
    // Zig
    "zig.path": "zig",
    "zig.formattingProvider": "extension",
    "zig.zls.enabled": "off",
    "[zig]": {
        "editor.defaultFormatter": "ziglang.vscode-zig",
        "editor.formatOnSave": true,
        "files.eol": "\n"
    },
    // TOML
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml",
        "editor.formatOnSave": true
    },
    // GitHub Copilot
    "chat.commandCenter.enabled": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.useAgentsMdFile": true,
    "chat.useClaudeMdFile": false,
    "chat.includeApplyingInstructions": true,
    "chat.includeReferencedInstructions": true,
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    "chat.useAgentSkills": true,
    "chat.agentSkillsLocations": {
        ".github/skills": true,
        "~/.copilot/skills": true,
        "~/.codex/skills": true,
        ".claude/skills": false,
        "~/.claude/skills": false
    },
    // Docker
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    "chat.agent.sandbox.enabled": "on"
}
