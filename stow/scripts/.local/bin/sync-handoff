#!/usr/bin/env bash
set -euo pipefail

SOURCE="$HOME/handoff/"
DEST="$HOME/PrivateDocs/handoff/"

mkdir -p "$DEST"

echo "==> Syncing handoff archive"
echo "    source: $SOURCE"
echo "    dest:   $DEST"
echo "    types:  *.md, *.txt"

rsync \
    --archive \
    --human-readable \
    --itemize-changes \
    --include='*/' \
    --include='*.md' \
    --include='*.txt' \
    --exclude='*' \
    "$SOURCE" \
    "$DEST"

echo
echo "==> Done"
du -sh "$DEST"
