#!/usr/bin/env python3

from pathlib import Path
import argparse
import re


def remove_rtf_group(text: str, marker: str) -> str:
    while True:
        start = text.find(marker)
        if start == -1:
            return text

        depth = 0
        end = None

        for i in range(start, len(text)):
            escaped = i > 0 and text[i - 1] == "\\"

            if text[i] == "{" and not escaped:
                depth += 1
            elif text[i] == "}" and not escaped:
                depth -= 1
                if depth == 0:
                    end = i + 1
                    break

        if end is None:
            return text

        text = text[:start] + text[end:]


def rtf_to_text(rtf: str) -> str:
    if not rtf.strip():
        return ""

    for marker in (
        r"{\fonttbl",
        r"{\colortbl",
        r"{\stylesheet",
        r"{\info",
        r"{\*\generator",
    ):
        rtf = remove_rtf_group(rtf, marker)

    def decode_hex_runs(match):
        raw = bytes(
            int(h, 16)
            for h in re.findall(
                r"\\'([0-9a-fA-F]{2})",
                match.group(0),
            )
        )
        return raw.decode("cp932", errors="replace")

    plain = re.sub(
        r"(?:\\'[0-9a-fA-F]{2})+",
        decode_hex_runs,
        rtf,
    )

    plain = re.sub(r"\\par\b ?", "\n", plain)
    plain = re.sub(r"\\line\b ?", "\n", plain)
    plain = re.sub(r"\\tab\b ?", "\t", plain)

    plain = plain.replace(r"\{", "{")
    plain = plain.replace(r"\}", "}")
    plain = plain.replace(r"\\", "\\")

    plain = re.sub(r"\\[a-zA-Z]+-?\d* ?", "", plain)
    plain = re.sub(r"\\[*~_-]", "", plain)

    plain = plain.replace("{", "").replace("}", "")

    lines = [line.rstrip() for line in plain.splitlines()]
    result = "\n".join(lines).strip()
    result = re.sub(r"\n{3,}", "\n\n", result)

    return result


def convert(src: Path, dst: Path) -> int:
    text = src.read_bytes().decode("cp932")
    lines = text.splitlines()

    output = [f"# {src.stem}", ""]
    group_depth = 0
    chapter_count = 0
    i = 0

    while i < len(lines):
        line = lines[i]

        if line == "<group>":
            group_depth += 1
            i += 1
            continue

        if line == "</group>":
            group_depth = max(0, group_depth - 1)
            i += 1
            continue

        if line.startswith("<chapter>"):
            title = line.removeprefix("<chapter>")
            level = min(6, 2 + group_depth)

            output.append(f"{'#' * level} {title}")
            output.append("")
            chapter_count += 1
            i += 1
            continue

        if line == "<content>":
            content = []
            i += 1

            while i < len(lines) and lines[i] != "</content>":
                content.append(lines[i])
                i += 1

            body = rtf_to_text("\n".join(content))

            if body:
                output.append(body)
                output.append("")

            if i < len(lines):
                i += 1
            continue

        i += 1

    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.write_text(
        "\n".join(output).rstrip() + "\n",
        encoding="utf-8",
    )

    return chapter_count


def main():
    parser = argparse.ArgumentParser(
        description="Convert NanaTree .nna files to UTF-8 Markdown."
    )
    parser.add_argument("source", type=Path)
    parser.add_argument("destination", type=Path)

    args = parser.parse_args()

    chapters = convert(args.source, args.destination)

    # 本文は表示しない。
    print(f"Converted: {args.source}")
    print(f"Output:    {args.destination}")
    print(f"Chapters:  {chapters}")


if __name__ == "__main__":
    main()
