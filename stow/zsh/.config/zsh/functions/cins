# ~/.config/zsh/functions/cins
# ELF とアドレスを指定して周辺を逆アセンブリして stdout
# 例: cins kernel.elf 0xffffffff80013dda 0x300
function cins() {
  emulate -L zsh
  setopt pipefail

  if (( $# < 2 )); then
    print -u2 "usage: cins <elf> <addr_hex> [range_bytes(hex|dec)]"
    return 2
  fi

  local elf="$1"
  local addr="$2"
  local range="${3:-0x200}"

  if [[ ! -f "$elf" ]]; then
    print -u2 "cins: not found: $elf"
    return 1
  fi

  # zsh 算術展開で 0x.. / dec どっちもいける
  local -i a r start stop
  a=$((addr))
  r=$((range))
  start=$((a - r/2))
  stop=$((a + r/2))

  # stderr は注意だけ
  print -u2 "cins: elf=$elf addr=$addr start=$(printf '0x%x' $start) stop=$(printf '0x%x' $stop)"

  command objdump -d --no-show-raw-insn \
    --start-address="$start" \
    --stop-address="$stop" \
    -- "$elf"
}
