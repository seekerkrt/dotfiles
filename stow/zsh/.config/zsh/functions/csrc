#autoload
# csrc: copy source context around an address using addr2line
# Usage:
#   csrc <elf> <addr> [-c context_lines] [--no-clip]
# Examples:
#   csrc kernel.elf 0xffffffff80013dda -c 40
csrc() {
  emulate -L zsh
  setopt pipefail

  local ctx=20 no_clip=0
  local elf="" addr=""

  while (( $# )); do
    case "$1" in
      -c|--context) ctx="${2:-$ctx}"; shift 2;;
      --no-clip)    no_clip=1; shift;;
      -h|--help)
        cat <<'EOF'
csrc: copy source context around an address
Usage: csrc <elf> <addr> [-c N] [--no-clip]
EOF
        return 0
        ;;
      *)
        if [[ -z "$elf" ]]; then elf="$1"
        elif [[ -z "$addr" ]]; then addr="$1"
        else print -u2 "csrc: extra arg ignored: $1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$elf" || -z "$addr" ]]; then
    print -u2 "csrc: usage: csrc <elf> <addr> [-c N]"
    return 2
  fi
  if [[ ! -f "$elf" ]]; then
    print -u2 "csrc: file not found: $elf"
    return 2
  fi

  local clip_cmd=""
  if command -v wl-copy >/dev/null 2>&1; then
    clip_cmd="wl-copy"
  elif command -v pbcopy >/dev/null 2>&1; then
    clip_cmd="pbcopy"
  elif command -v xclip >/dev/null 2>&1; then
    clip_cmd="xclip -selection clipboard"
  fi

  local a2l="addr2line"
  command -v gaddr2line >/dev/null 2>&1 && a2l="gaddr2line"
  if ! command -v "$a2l" >/dev/null 2>&1; then
    print -u2 "csrc: addr2line not found"
    return 127
  fi

  # addr2line: "file:line" を取る（-f で関数名も）
  local info func loc file line
  info="$("$a2l" -e "$elf" -f -C -- "$addr" 2>/dev/null)" || return 1
  func="$(print -r -- "$info" | sed -n '1p')"
  loc="$(print -r -- "$info" | sed -n '2p')"

  file="${loc%%:*}"
  line="${loc##*:}"

  if [[ -z "$file" || "$file" == "??" || ! -f "$file" ]]; then
    # ビルドディレクトリとソース位置がズレてる時があるので注意喚起
    local out="ELF: $elf\nADDR: $addr\nFUNC: $func\nLOC : $loc\n----------------------------------------\n[csrc] source file not found. (Maybe no debug info, or paths differ.)\n----------------------------------------"
    if (( no_clip )) || [[ -z "$clip_cmd" ]]; then
      print -r -- "$out"
      return 1
    fi
    print -r -- "$out" | eval "$clip_cmd"
    print -r -- "csrc: copied info only (source missing): $loc"
    return 1
  fi

  # line が数字でない場合の保険
  if [[ "$line" != <-> ]]; then
    line=1
  fi

  local start=$(( line - ctx ))
  (( start < 1 )) && start=1
  local end=$(( line + ctx ))

  local out
  out="$(
    {
      echo "ELF: $elf"
      echo "ADDR: $addr"
      echo "FUNC: $func"
      echo "File: $file:$line"
      echo "----------------------------------------"
      # 行番号つきで周辺表示（nlは軽くて便利）
      sed -n "${start},${end}p" -- "$file" | nl -ba -w4 -s': ' -v "$start"
      echo "----------------------------------------"
    } | sed 's/[[:space:]]\+$//'
  )"

  if (( no_clip )) || [[ -z "$clip_cmd" ]]; then
    print -r -- "$out"
    [[ -z "$clip_cmd" ]] && print -u2 "csrc: (no clipboard tool) printed to stdout"
    return 0
  fi

  print -r -- "$out" | eval "$clip_cmd"
  print -r -- "csrc: copied to clipboard (${clip_cmd%% *}) from $file:$line"
}
