# ~/.config/zsh/functions/csrc
# ELF+アドレスから file:line を引いてソース周辺を stdout
# 例: csrc kernel.elf 0xffffffff80013dda 10
function csrc() {
  emulate -L zsh
  setopt pipefail

  if (( $# < 2 )); then
    print -u2 "usage: csrc <elf> <addr_hex> [context_lines]"
    return 2
  fi

  local elf="$1"
  local addr="$2"
  local ctx="${3:-8}"

  if [[ ! -f "$elf" ]]; then
    print -u2 "csrc: not found: $elf"
    return 1
  fi

  local loc file line
  loc="$(command addr2line -e "$elf" -f -C "$addr" 2>/dev/null | command tail -n 1)"
  # loc 形式: path/to/file:line  or  ??:0
  file="${loc%:*}"
  line="${loc##*:}"

  if [[ "$file" == "??" || "$line" == "0" || -z "$file" ]]; then
    print -u2 "csrc: addr2line failed for $addr (need -g?)"
    return 1
  fi

  if [[ ! -f "$file" ]]; then
    # ここはプロジェクト都合で “相対化” したくなることが多い
    # いったんそのままエラー（stdout 汚さない）
    print -u2 "csrc: source not found on filesystem: $file"
    print -u2 "      (hint) build path may differ; consider using debug prefix map later"
    return 1
  fi

  local -i l c start stop
  l=$((line))
  c=$((ctx))
  start=$((l - c)); (( start < 1 )) && start=1
  stop=$((l + c))

  print -u2 "csrc: $addr => $file:$line (show ${start}-${stop})"

  # 行番号付きで出す（見やすい）
  command nl -ba -- "$file" | command sed -n "${start},${stop}p"
}
