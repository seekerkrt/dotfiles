# ~/.config/zsh/functions/cpfunc
# パターン一致行から { } のネストを数えてブロック抽出して stdout
# 例: cpfunc 'Window::puts' src/gui/Window.cpp
function cpfunc() {
  emulate -L zsh
  setopt pipefail

  if (( $# < 2 )); then
    print -u2 "usage: cpfunc <pattern> <file...>"
    return 2
  fi

  local pattern="$1"; shift
  local -a files=("$@")

  local f
  for f in "${files[@]}"; do
    if [[ ! -f "$f" ]]; then
      print -u2 "cpfunc: skip (not file): $f"
      continue
    fi

    print "===== FILE: ${f} / PATTERN: ${pattern} ====="
    # awk でゆるくブロック抽出
    command awk -v pat="$pattern" '
      function count_braces(s,   i,c){
        c=0
        for(i=1;i<=length(s);i++){
          ch=substr(s,i,1)
          if(ch=="{") c++
          else if(ch=="}") c--
        }
        return c
      }
      BEGIN{inblk=0; lvl=0; hit=0}
      {
        if(!inblk){
          if($0 ~ pat){
            inblk=1; hit=1
            print $0
            lvl += count_braces($0)
            # 関数シグネチャだけで { が次行に来る場合もあるので継続
            next
          }
        } else {
          print $0
          lvl += count_braces($0)
          if(lvl <= 0 && $0 ~ /}/){
            inblk=0; lvl=0
            print ""  # separator
          }
        }
      }
      END{
        if(!hit){
          # stdout を汚さないため、未ヒットは stderr へは出せないので何もしない
        }
      }
    ' -- "$f"
  done
}
