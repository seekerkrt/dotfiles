cpfunc() {
  emulate -L zsh
  setopt pipefail

  local opt_stdout=0
  local opt_path=0

  # ---- options ----
  while (( $# > 0 )); do
    case "$1" in
      -n|--stdout) opt_stdout=1; shift ;;
      -p|--path)   opt_path=1; shift ;;
      -h|--help)
        cat >&2 <<'EOF'
usage:
  cpfunc [-n|--stdout] [-p|--path] <FuncNameOrQualified> [file]

options:
  -n, --stdout   抽出結果を stdout に出す（wl-copy しない）
  -p, --path     抽出に成功したファイルパスだけを出す（中身は出さない）
EOF
        return 0
        ;;
      --) shift; break ;;
      -*) echo "[cpfunc] unknown option: $1" >&2; return 2 ;;
      *) break ;;
    esac
  done

  if (( opt_stdout && opt_path )); then
    echo "[cpfunc] -n and -p are mutually exclusive" >&2
    return 2
  fi

  local name="$1"
  local file="$2"

  if [[ -z "$name" ]]; then
    echo "usage: cpfunc [-n|--stdout] [-p|--path] <FuncNameOrQualified> [file]" >&2
    return 2
  fi

  local -a candidates okfiles
  local py="$HOME/.local/bin/cpfunc.py"

  if [[ ! -x "$py" ]]; then
    echo "[cpfunc] missing executable: $py" >&2
    return 1
  fi

  if [[ -n "$file" ]]; then
    candidates=("$file")
  else
    candidates=("${(@f)$(rg -l --hidden --no-ignore-vcs \
      --glob '*.{c,cc,cxx,cpp,h,hh,hxx,hpp}' \
      -- "(^|[^[:alnum:]_])${name//:/::}[[:space:]]*\\(" \
      src include 2>/dev/null)}")

    if (( ${#candidates[@]} == 0 )); then
      echo "[cpfunc] no candidates for: $name" >&2
      return 1
    fi
  fi

  # 候補を実抽出でふるいにかける（成功したファイルだけ残す）
  local f
  for f in "${candidates[@]}"; do
    "$py" "$name" "$f" >/dev/null 2>&1 && okfiles+=("$f")
  done

  if (( ${#okfiles[@]} == 0 )); then
    echo "[cpfunc] extract failed in all candidates: $name" >&2
    echo "  tip: try qualified name (e.g. Window::Resize) or specify file" >&2
    return 1
  fi

  local target
  if (( ${#okfiles[@]} == 1 )); then
    target="$okfiles[1]"
  else
    if command -v fzf >/dev/null; then
      target="$(printf '%s\n' "${okfiles[@]}" | fzf --prompt="cpfunc> " --height=40%)" || return 1
    else
      echo "[cpfunc] multiple matches; specify file:" >&2
      printf '  %s\n' "${okfiles[@]}" >&2
      return 1
    fi
  fi

  # ---- output modes ----
  if (( opt_path )); then
    print -r -- "$target"
    return 0
  fi

  if (( opt_stdout )); then
    "$py" "$name" "$target"
    return $?
  fi

  # default: copy to clipboard if available
  if command -v wl-copy >/dev/null; then
    "$py" "$name" "$target" | wl-copy
    echo "[cpfunc] copied: $name ($target)" >&2
  else
    "$py" "$name" "$target"
  fi
}
