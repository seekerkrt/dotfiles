cpfunc() {
  emulate -L zsh
  setopt pipefail

  local name="$1"
  local file="$2"

  if [[ -z "$name" ]]; then
    echo "usage: cpfunc <FuncNameOrQualified> [file]" >&2
    return 2
  fi

  local -a candidates okfiles
  local py="$HOME/.local/bin/cpfunc.py"

  if [[ ! -x "$py" ]]; then
    echo "[cpfunc] missing executable: $py" >&2
    return 1
  fi

  if [[ -n "$file" ]]; then
    candidates=("$file")
  else
    # まず “名前(” が出るファイルを広めに拾う（定義/呼び出し混在OK）
    candidates=("${(@f)$(rg -l --hidden --no-ignore-vcs \
      --glob '*.{c,cc,cxx,cpp,h,hh,hxx,hpp}' \
      -- "(^|[^[:alnum:]_])${name//:/::}[[:space:]]*\\(" \
      src include 2>/dev/null)}")

    if (( ${#candidates[@]} == 0 )); then
      echo "[cpfunc] no candidates for: $name" >&2
      return 1
    fi
  fi

  # ここが肝：候補それぞれで実抽出を試して「成功したファイル」だけ残す
  local f
  for f in "${candidates[@]}"; do
    "$py" "$name" "$f" >/dev/null 2>&1 && okfiles+=("$f")
  done

  if (( ${#okfiles[@]} == 0 )); then
    echo "[cpfunc] extract failed in all candidates: $name" >&2
    echo "  tip: try qualified name (e.g. Window::Resize) or specify file" >&2
    return 1
  fi

  local target
  if (( ${#okfiles[@]} == 1 )); then
    target="$okfiles[1]"
  else
    if command -v fzf >/dev/null; then
      target="$(printf '%s\n' "${okfiles[@]}" | fzf --prompt="cpfunc> " --height=40%)" || return 1
    else
      echo "[cpfunc] multiple matches; specify file:" >&2
      printf '  %s\n' "${okfiles[@]}" >&2
      return 1
    fi
  fi

  # 抽出 → wl-copy（なければ stdout）
  if command -v wl-copy >/dev/null; then
    "$py" "$name" "$target" | wl-copy
    echo "[cpfunc] copied: $name ($target)" >&2
  else
    "$py" "$name" "$target"
  fi
}

