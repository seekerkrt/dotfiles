# cpfunc: extract C/C++ { ... } block starting at pattern -> clipboard (wl-copy)
# usage:
#   cpfunc [-i] <pattern> <file>        # copy to clipboard
#   cpfunc -p [-i] <pattern> <file>     # print to stdout
#
# notes:
# - if extraction is empty, it will NOT overwrite clipboard.

emulate -L zsh
set -euo pipefail

print_mode=0
ignore_case=0

# parse options (-p, -i) in any order
while [[ $# -ge 1 ]]; do
  case "$1" in
    -p) print_mode=1; shift ;;
    -i) ignore_case=1; shift ;;
    --) shift; break ;;
    -*) echo "cpfunc: unknown option: $1" >&2; return 2 ;;
    *)  break ;;
  esac
done

pat="${1:-}"
file="${2:-}"

if [[ -z "$pat" || -z "$file" ]]; then
  echo "usage: cpfunc [-p] [-i] <pattern> <file>" >&2
  return 2
fi
if [[ ! -f "$file" ]]; then
  echo "cpfunc: not a file: $file" >&2
  return 2
fi

# AWK: find first line containing pattern (optionally case-insensitive),
# then print until the matching { ... } block closes.
out="$(
  awk -v pat="$pat" -v ic="$ignore_case" '
    function contains(hay, needle) {
      if (ic) return index(tolower(hay), tolower(needle)) > 0
      return index(hay, needle) > 0
    }
    BEGIN { hit=0; depth=0; started=0; }
    {
      if (!hit) {
        if (contains($0, pat)) { hit=1; }
        else next
      }
      print
      for (i=1; i<=length($0); i++) {
        c=substr($0,i,1)
        if (c=="{") { depth++; started=1 }
        else if (c=="}") { depth-- }
      }
      if (started && depth<=0) exit
    }
  ' "$file"
)"

if [[ -z "$out" ]]; then
  echo "cpfunc: pattern not found or extracted empty (won't overwrite clipboard): $pat ($file)" >&2
  return 1
fi

if (( print_mode )); then
  printf "%s\n" "$out"
else
  printf "%s\n" "$out" | wl-copy
  echo "cpfunc: copied block: $pat ($file)"
fi
