# C/C++/ASM/NASM 系プロジェクトを1枚のテキストに結合してAIに投げる用
function pack_source_files() {
    local target_dir="$1"
    local output_file="$2"

    if [ -z "$target_dir" ] || [ -z "$output_file" ]; then
        echo "Usage: pack_source_files <target_dir> <output_file>"
        echo "Example: pack_source_files ./jadec jadec_all_code.txt"
        return 2
    fi

    if [ ! -d "$target_dir" ]; then
        echo "Error: Directory '$target_dir' not found."
        return 1
    fi

    local output_dir
    output_dir="$(dirname "$output_file")"

    if [ ! -d "$output_dir" ]; then
        echo "Error: Output directory '$output_dir' not found."
        return 1
    fi

    echo "Packing source files from '$target_dir' into '$output_file' ..."

    {
        printf '# Packed source files\n'
        printf '# Target: %s\n' "$target_dir"
        printf '# Generated: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')"
        printf '\n'

        find "$target_dir" \
            \( -path "*/.git" \
            -o -path "*/build" \
            -o -path "*/cmake-build-*" \
            -o -path "*/.cache" \
            -o -path "*/.ccls-cache" \
            -o -path "*/node_modules" \) -prune \
            -o -type f \( \
                -name "*.c" -o \
                -name "*.cc" -o \
                -name "*.cpp" -o \
                -name "*.cxx" -o \
                -name "*.h" -o \
                -name "*.hh" -o \
                -name "*.hpp" -o \
                -name "*.hxx" -o \
                -name "*.asm" -o \
                -name "*.nasm" -o \
                -name "*.s" -o \
                -name "*.S" -o \
                -name "*.jc" -o \
                -name "CMakeLists.txt" -o \
                -name "Makefile" -o \
                -name "README.md" -o \
                -name "AGENTS.md" -o \
                -name "CLAUDE.md" -o \
                -path "*/docs/*.md" \
            \) -print0 \
        | sort -z \
        | while IFS= read -r -d '' file; do
            printf '\n'
            printf '============================================================\n'
            printf 'FILE: %s\n' "$file"
            printf '============================================================\n\n'
            cat "$file"
            printf '\n'
        done
    } > "$output_file"

    echo "Done! Saved to $(realpath "$output_file")"
    echo "You can now upload this file to Gemini/ChatGPT/etc."
}
