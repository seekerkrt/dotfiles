[user]
	name = seekerkrt
	email = 4817613+seekerkrt@users.noreply.github.com

[color]
	diff = auto
	status = auto
	branch = auto
	ui = auto

[core]
	autocrlf = input
	fileMode = false
	pager = cat
	quotePath = false

[init]
	defaultBranch = main

[pull]
	rebase = true
	ff = only

[sendpack]
	sideband = false

[push]
	followTags = true
[alias]
    mff = merge --ff-only
[pager]
       log = false
