{
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(make -j:*)",
      "Bash(qemu-system-x86_64:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(eza:*)",
      "Bash(cat:*)",
      "Bash(bat:*)",
      "Bash(grep:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git add:*)"
    ],
    "additionalDirectories": [
      "~/handoff"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.local/npm-global/bin/ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "language": "Japanese",
  "effortLevel": "xhigh",
  "theme": "dark",
  "autoCompactEnabled": true
}
