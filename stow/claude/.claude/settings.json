{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "5"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.local/npm-global/bin/ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "language": "Japanese",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark",
  "autoCompactEnabled": true,
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(sudo:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)"
    ],
    "blockWritesOutsideWorkingDirectories": true,
    "additionalDirectories": [
      "/ramdisk",
      "~/handoffs",
      "~/scratch"
    ],
    "allow": [
      "Bash(ctest *)",
      "Bash(docker container ls -a)",
      "Bash(docker container ls)",
      "Bash(docker image ls)",
      "Bash(docker images)",
      "Bash(docker info)",
      "Bash(docker network ls)",
      "Bash(docker ps -a)",
      "Bash(docker ps)",
      "Bash(docker system df)",
      "Bash(docker version)",
      "Bash(docker volume ls)",
      "Bash(env -u MAKEFLAGS -u MFLAGS TMPDIR=/ramdisk make *)",
      "Bash(gh api --method GET *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(git add -- *)",
      "Bash(git commit -m *)",
      "Bash(git diff --check *)",
      "Bash(git ls-remote *)",
      "Bash(git ls-remote --heads gitlab)",
      "Bash(git ls-remote --heads origin)",
      "Bash(git ls-remote gitlab refs/heads/develop)",
      "Bash(git ls-remote origin refs/heads/develop)",
      "Bash(make *)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(gh pr create *)",
      "Bash(git * push *)",
      "Bash(git add -- .)",
      "Bash(git add --all *)",
      "Bash(git add -A *)",
      "Bash(git add .)",
      "Bash(git branch --delete *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git clean *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git update-ref *)",
      "mcp__*"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "gitlab.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/ramdisk"
      ],
      "denyRead": [
        "~/.config/gh",
        "~/.gnupg",
        "~/.ssh"
      ]
    },
    "excludedCommands": [
      "docker container ls",
      "docker container ls -a",
      "docker image ls",
      "docker images",
      "docker info",
      "docker network ls",
      "docker ps",
      "docker ps -a",
      "docker system df",
      "docker version",
      "docker volume ls",
      "gh issue list *",
      "gh issue view *",
      "gh pr create *",
      "gh pr list *",
      "gh pr list --limit 3",
      "gh pr view *",
      "gh release list *",
      "gh release view *",
      "gh repo list *",
      "gh repo view *",
      "gh run list *",
      "gh run view *",
      "gh workflow list *",
      "gh workflow view *",
      "git fetch gitlab *",
      "git fetch origin *",
      "git ls-remote --heads gitlab",
      "git ls-remote --heads origin",
      "git ls-remote gitlab HEAD",
      "git ls-remote gitlab refs/heads/develop",
      "git ls-remote origin HEAD",
      "git ls-remote origin refs/heads/develop",
      "git pull --ff-only gitlab *",
      "git pull --ff-only origin *",
      "git push gitlab *",
      "git push origin *"
    ]
  }
}
