prefix_rule(
    pattern=["gh", "issue", "view"],
    decision="allow",
    justification="GitHub Issueの参照専用コマンドを自動許可する",
    match=[
        "gh issue view 203",
        "gh issue view 203 --comments",
        "gh issue view 203 --json number,title,body,state,labels,assignees,comments,url",
        "gh issue view 203 --repo seekerkrt/jadeos",
    ],
    not_match=[
        "gh issue list",
        "gh issue edit 203",
        "gh issue close 203",
        "gh issue create",
        "gh pr view 203",
    ],
)
