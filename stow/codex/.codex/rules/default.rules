prefix_rule(pattern=["/bin/zsh", "-lc", "gh api --method GET --paginate 'repos/seekerkrt/jpacker/pulls?state=all&per_page=100' --jq '.[] | select(.merged_at != null) | .number' | while IFS= read -r pr; do [[ \"$pr\" == <-> ]] || continue; gh api --method GET --paginate \"repos/seekerkrt/jpacker/pulls/$pr/commits?per_page=100\" --jq '.[] | [.sha,(.author.login // \"<null>\"),.commit.author.name,.commit.author.email,(.committer.login // \"<null>\"),.commit.committer.name,.commit.committer.email] | @tsv' | while IFS= read -r row; do printf '%s\\t%s\\n' \"$pr\" \"$row\"; done; done | awk -F '\\t' '!seen[$2]++ {unique++; akey=$4 \" <\" $5 \">\"; ckey=$7 \" <\" $8 \">\"; alogin[$3]++; clogin[$6]++; authors[akey]++; committers[ckey]++; if ($3!=\"seekerkrt\" && $3!=\"<null>\") external_author[++ea]=$0; if ($6!=\"seekerkrt\" && $6!=\"<null>\" && $6!=\"web-flow\") external_committer[++ec]=$0} END {printf \"UNIQUE_PR_COMMITS=%d\\n\", unique; for (k in authors) printf \"RAW_AUTHOR_COUNT=%d\\t%s\\n\",authors[k],k; for (k in committers) printf \"RAW_COMMITTER_COUNT=%d\\t%s\\n\",committers[k],k; for (k in alogin) printf \"GITHUB_AUTHOR_LOGIN_COUNT=%d\\t%s\\n\",alogin[k],k; for (k in clogin) printf \"GITHUB_COMMITTER_LOGIN_COUNT=%d\\t%s\\n\",clogin[k],k; for (i=1;i<=ea;i++) print \"EXTERNAL_AUTHOR_CANDIDATE\\t\" external_author[i]; for (i=1;i<=ec;i++) print \"EXTERNAL_COMMITTER_CANDIDATE\\t\" external_committer[i]}'"], decision="allow")
