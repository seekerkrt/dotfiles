cmake.outline.buildAll","when":"resourceFilename == CMakeLists.txt && cmake:enableFullFeatureSet"},{"command":"cmake.outline.cleanAll","when":"resourceFilename == CMakeLists.txt && cmake:enableFullFeatureSet"},{"command":"cmake.outline.cleanConfigureAll","when":"resourceFilename == CMakeLists.txt"},{"command":"cmake.outline.cleanConfigureAllWithDebugger","when":"resourceFilename == CMakeLists.txt && cmake:cmakeDebuggerAvailable"},{"command":"cmake.outline.cleanRebuildAll","when":"resourceFilename == CMakeLists.txt && cmake:enableFullFeatureSet"}],"touchBar":[{"command":"cmake.quickStart","when":"cmake:enableTouchBar && !cmake:enableFullFeatureSet","group":"CMake:start"},{"command":"cmake.configure","when":"cmake:enableTouchBar.configure && !cmake:isBuilding && !cmake:isConfiguring","group":"CMake:build"},{"command":"cmake.build","alt":"cmake.configure","when":"cmake:enableTouchBar.build && cmake:enableFullFeatureSet && !cmake:isBuilding && !cmake:isConfiguring","group":"CMake:build"},{"command":"cmake.stop","when":"cmake:enableTouchBar.build && cmake:enableFullFeatureSet && cmake:isBuilding","group":"CMake:build"},{"command":"cmake.debugTarget","alt":"cmake.selectLaunchTarget","when":"cmake:enableTouchBar.debug && cmake:enableFullFeatureSet && !cmake:hideDebugCommand","group":"CMake:run"},{"command":"cmake.launchTarget","when":"cmake:enableTouchBar.launch && cmake:enableFullFeatureSet && !cmake:hideLaunchCommand","group":"CMake:run"}]},"configuration":{"type":"object","title":"CMake Tools","properties":{"cmake.autoSelectActiveFolder":{"type":"boolean","default":true,"description":"アクティブなフォルダーを自動的に選択します。","scope":"window"},"cmake.defaultActiveFolder":{"type":"string","default":"","description":"既定のアクティブ フォルダーを設定します (cmake.autoSelectActiveFolder が無効である場合にのみ機能します)。","scope":"window"},"cmake.exclude":{"type":"array","items":{"type":"string"},"default":[],"description":"この拡張機能は、この設定に記載されたフォルダーを無視します。フォルダーは絶対パスで指定する必要があります。","scope":"window"},"cmake.cmakePath":{"type":"string","default":"cmake","description":"使用する CMake 実行可能ファイルの名前またはパスです。","scope":"resource"},"cmake.buildDirectory":{"type":"string","default":"${workspaceFolder}/build","description":"CMake のビルド ファイルが格納されるディレクトリです。","scope":"resource"},"cmake.installPrefix":{"type":"string","default":null,"description":"CMake でインストールされるファイルが格納されるディレクトリ。","scope":"resource"},"cmake.sourceDirectory":{"oneOf":[{"type":"string"},{"type":"array","items":{"type":"string"}}],"description":"CMakeLists.txt ルート/ディレクトリへのパスまたはパスの配列。","default":"${workspaceFolder}","scope":"resource"},"cmake.saveBeforeBuild":{"type":"boolean","default":true,"description":"ビルドの前に、開いているファイルを保存します。","scope":"resource"},"cmake.buildBeforeRun":{"type":"boolean","default":true,"description":"実行する前にターゲットをビルドします。","scope":"resource"},"cmake.clearOutputBeforeBuild":{"type":"boolean","default":true,"description":"ビルドの前に毎回ビルド出力をクリアします。","scope":"resource"},"cmake.configureSettings":{"type":"object","default":{},"additionalProperties":{"oneOf":[{"type":"string"},{"type":"boolean"},{"type":"number"},{"type":"array","items":{"type":"string"}},{"type":"object","properties":{"type":{"type":"string","enum":["","BOOL","STRING","FILEPATH","PATH"]},"value":{}},"additionalProperties":false,"required":["type","value"]}]},"description":"コマンド ラインで設定する CMake 変数です。この設定はキットに固有であり、CMake プリセットには使用されません。","scope":"resource"},"cmake.cacheInit":{"oneOf":[{"type":"string","description":"キャッシュを初期化する CMake ファイルへのパスです。"},{"type":"array","description":"キャッシュ初期化子ファイルの一覧です。","items":{"type":"string","description":"キャッシュを初期化する CMake ファイルです。"}}],"description":"CMake ファイルのキャッシュを初期化します。","scope":"resource"},"cmake.preferredGenerators":{"type":"array","default":[],"description":"構成時に使用する優先 CMake ジェネレーターです (一覧にある順序で試行されます)。","scope":"resource"},"cmake.generator":{"type":"string","default":null,"description":"使用する CMake ジェネレーターです。","scope":"resource"},"cmake.toolset":{"type":"string","default":null,"description":"構成時に使用する CMake ツールセットです。","scope":"resource"},"cmake.platform":{"type":"string","default":null,"description":"構成時に使用する CMake プラットフォームです。","scope":"resource"},"cmake.configureArgs":{"type":"array","description":"構成時に CMake に渡す追加の引数です。CMake プリセットを使用する場合、これらの引数は、アクティブな構成プリセットによって提供される引数に一時的に追加されます。","items":{"type":"string","title":"CMake Arguments"},"default":[],"scope":"resource"},"cmake.buildArgs":{"type":"array","description":"ビルド時に CMake に渡す追加の引数です。CMake プリセットを使用する場合、これらの引数は、アクティブなビルド プリセットによって提供される引数に一時的に追加されます。","items":{"type":"string"},"default":[],"scope":"resource"},"cmake.buildToolArgs":{"type":"array","description":"ビルド時に基になるビルド ツールに渡す追加の引数です。CMake プリセットを使用する場合、これらの引数は、ビルド ツールを呼び出すためにアクティブなビルド プリセットによって提供される引数に一時的に追加されます。","items":{"type":"string"},"default":[],"scope":"resource"},"cmake.parallelJobs":{"type":"number","default":0,"description":"並列ビルド ジョブの数。CPU 数を自動的に検出するには、0 を使用します。これを 1 に設定すると、基になるビルド コマンドから並列処理フラグ (-j) が省略されます。このコマンドは、ビルドの並列処理に対してジェネレーターに依存する影響を与えます。","scope":"resource"},"cmake.ctestPath":{"type":"string","default":null,"description":"CTest 実行可能ファイルへのパス。null の場合、cmake.cmakePath から推論されます (null のままにすることをお勧めします)。","scope":"resource"},"cmake.cpackPath":{"type":"string","default":null,"when":"useCMakePresets == true","description":"CPack 実行可能ファイルへのパス。null の場合、cmake.cmakePath から推論されます (null のままにすることをお勧めします)。キットがプリセットの代わりに使用される場合は無視されます。","scope":"resource"},"cmake.ctest.parallelJobs":{"type":"number","default":0,"markdownDescription":"並列テスト ジョブの数。`#cmake.parallelJobs#` の値を使用するには、0 を使用します。これは、`#cmake.ctest.allowParallelJobs#` が `true` に設定されている場合にのみ適用されます。","scope":"resource"},"cmake.ctest.allowParallelJobs":{"type":"boolean","default":false,"description":"ctest を並列で実行できますが、結果として結果出力が文字化けし、テスト エクスプローラーにテストの進行状況が正確に反映されない場合があります。","scope":"resource"},"cmake.ctest.testExplorerIntegrationEnabled":{"type":"boolean","default":true,"description":"テスト エクスプローラーとの統合が有効になっているかどうか。テスト統合に別の拡張機能を使用する場合には、これを無効にすることが適しています。","scope":"machine-overridable"},"cmake.ctest.testSuiteDelimiter":{"type":"string","default":null,"markdownDescription":"テスト エクスプローラーでテスト スイート名とグループ テストを階層的に区切るために使用される省略可能な区切り記号。この文字列は正規表現で使用されるため、一部の区切り記号ではエスケープが必要になる場合があります。例: `-` (1 つの区切り記号: `-`)、`\\.|::` (2 つの区切り記号: `.` または `::`。`.` はエスケープする必要があることに注意してください)。","scope":"machine-overridable"},"cmake.ctest.testSuiteDelimiterMaxOccurrence":{"type":"number","default":0,"markdownDescription":"区切り記号を使用してテストの名前を分割できる最大回数。`0` は制限がないことを意味します。","scope":"machine-overridable"},"cmake.ctest.debugLaunchTarget":{"type":"string","default":null,"description":"CTest を使用してテストをデバッグするときに開始する launch.json のターゲット名。既定では、存在しないターゲットの場合は、使用可能なすべてのターゲットを含むピッカーが表示されます。","scope":"resource"},"cmake.parseBuildDiagnostics":{"type":"boolean","default":true,"description":"コンパイラ出力の警告とエラーを解析します。","scope":"resource"},"cmake.enabledOutputParsers":{"type":"array","markdownDescription":"使用する出力パーサー。サポートされるパーサーは、GNULD スタイルのリンカー出力の場合は `cmake`、`gcc`、`gnuld`、Microsoft Visual C++ の場合は `msvc`、--no_wrap_diagnostics --brief_diagnostics を指定した Green Hills Compiler の場合は `ghs`、Wind River Diab Compiler の場合は `diab` です。","items":{"type":"string","enum":["cmake","gcc","gnuld","msvc","ghs","diab","iar"]},"default":["cmake","gcc","gnuld","msvc","ghs","diab"],"scope":"resource"},"cmake.debugConfig":{"type":"object","description":"ターゲットのデバッグ時に使用するデバッグ構成です。","properties":{"symbolSearchPath":{"type":"string","description":"Visual Studio デバッガーのシンボル検索パスです。"},"additionalSOLibSearchPath":{"type":"string","description":".so ファイルを検索する GDB または LLDB のパスです。"},"externalConsole":{"type":"boolean","description":"プログラムの外部コンソールを起動します。"},"console":{"type":"string","enum":["internalConsole","integratedTerminal","externalTerminal","newExternalWindow"],"enumDescriptions":["VS Code デバッグ コンソールに出力します。これはコンソール入力の読み取りをサポートしていません (例: `std::cin` または `scanf`)。","VS Code の統合ターミナルです。","コンソール アプリケーションは、外部ターミナル ウィンドウで起動されます。このウィンドウは再起動のシナリオで再利用され、アプリケーションが終了しても自動的に消えません。","コンソール アプリケーションは、アプリケーションの停止時に終了する独自の外部コンソール ウィンドウで起動されます。コンソール以外のアプリケーションはターミナルなしで実行され、stdout および stderr は無視されます。"],"markdownDescription":"デバッグ ターゲットを起動する場所です。定義されていない場合、既定は `internalConsole` です。"},"logging":{"type":"object","description":"どの種類のメッセージをコンソールに記録する必要があるかを指定します。","properties":{"exceptions":{"type":"boolean","default":true},"moduleLoad":{"type":"boolean","default":true},"programOutput":{"type":"boolean","default":true},"engineLogging":{"type":"boolean","default":false},"trace":{"type":"boolean","default":false},"traceResponse":{"type":"boolean","default":false}}},"visualizerFile":{"anyOf":[{"type":"string","default":""},{"type":"array","default":[],"items":{"type":"string"}}],"description":"デバッグ時に使用する .natvis ファイルです。"},"args":{"type":"array","description":"プログラムのコマンド ラインに渡す引数です。","items":{"type":"string"},"default":[]},"cwd":{"type":"string","description":"プログラムの作業ディレクトリを設定します。"},"environment":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string","description":"環境変数の名前です。"},"value":{"type":"string","description":"環境変数の値です。"}}}},"MIMode":{"type":"string","enum":["gdb","lldb"]},"miDebuggerPath":{"type":"string","description":"gdb または lldb デバッガーへのパスです。"},"stopAtEntry":{"type":"boolean","description":"ターゲットのエントリ ポイントで停止します。","default":false},"setupCommands":{"type":"array","description":"gdb または lldb を設定するためのコマンドです。","items":{"type":"object","properties":{"text":{"type":"string","description":"実行するコマンドです。"},"description":{"type":"string","description":"コマンドの説明です。"},"ignoreFailures":{"type":"boolean","default":false}}}},"customLaunchSetupCommands":{"type":"array","description":"gdb または lldb を設定するためのコマンドです。","items":{"type":"object","properties":{"text":{"type":"string","description":"実行するコマンドです。"},"description":{"type":"string","description":"コマンドの説明です。"},"ignoreFailures":{"type":"boolean","default":false}}}},"launchCompleteCommand":{"type":"string"},"dumpPath":{"type":"string"},"coreDumpPath":{"type":"string"}},"scope":"resource"},"cmake.defaultVariants":{"type":"object","$schema":"cmake-tools-schema://schemas/variants-schema.json","description":"既定のバリアント設定を構成します。","default":{"buildType":{"default":"debug","description":"ビルドの種類です。","choices":{"debug":{"short":"Debug","long":"最適化の無効化 - デバッグ情報を含めます。","buildType":"Debug"},"release":{"short":"Release","long":"速度を最適化 - デバッグ情報を除外します。","buildType":"Release"},"minsize":{"short":"MinSizeRel","long":"最小のバイナリ サイズ用に最適化 - デバッグ情報を除外します。","buildType":"MinSizeRel"},"reldeb":{"short":"RelWithDebInfo","long":"速度を最適化 - デバッグ情報を含めます。","buildType":"RelWithDebInfo"},"unspecified":{"short":"Unspecified","long":"CMake が既定のビルドの種類を選択するようにします。","buildType":"Unspecified"}}}},"scope":"resource"},"cmake.ctestArgs":{"type":"array","items":{"type":"string"},"description":"CTest に渡す追加の引数です。CMake プリセットを使用する場合、これらの引数は、アクティブなテスト プリセットによって提供される引数に一時的に追加されます。","default":[],"scope":"resource"},"cmake.ctestDefaultArgs":{"type":"array","items":{"type":"string"},"description":"CTest に既定で渡される引数。","default":["-T","test","--output-on-failure"],"scope":"machine-overridable"},"cmake.cpackArgs":{"type":"array","when":"useCMakePresets == true","items":{"type":"string"},"description":"CPack に渡す追加の引数です (プリセットを使用している場合のみ。キットではサポートされていません)。これらの引数は、アクティブなパッケージ プリセットによって提供される引数に一時的に追加されます。","default":[],"scope":"resource"},"cmake.environment":{"type":"object","default":{},"description":"CMake コマンドの実行時に設定する環境変数です。CMake プリセットを使用する場合、これらは CMake コマンドに使用される環境に一時的に追加されます。","additionalProperties":{"type":"string","description":"環境変数の値です。"},"scope":"resource"},"cmake.configureEnvironment":{"type":"object","default":{},"description":"構成中に CMake に渡す環境変数です。CMake プリセットを使用する場合、これらはアクティブな構成プリセットによって提供される環境に一時的に追加されます。","additionalProperties":{"type":"string","description":"環境変数の値です。"},"scope":"resource"},"cmake.buildEnvironment":{"type":"object","default":{},"description":"ビルド中に CMake に渡す環境変数です。CMake プリセットを使用する場合、これらはアクティブなビルド プリセットによって提供される環境に一時的に追加されます。","additionalProperties":{"type":"string","description":"環境変数の値です。"},"scope":"resource"},"cmake.testEnvironment":{"type":"object","default":{},"description":"CTest に渡す環境変数です。CMake プリセットを使用する場合、これらはアクティブなテスト プリセットによって提供される環境に一時的に追加されます。","additionalProperties":{"type":"string","description":"環境変数の値です。"},"scope":"resource"},"cmake.cpackEnvironment":{"type":"object","default":{},"when":"useCMakePresets == true","description":"CPack を使用してパッケージ化するときに設定する環境変数 (プリセットを使用する場合のみ。キットではサポートされていません)。これらは、CPack の実行に使用される環境に一時的に追加されます。","additionalProperties":{"type":"string","description":"環境変数の値です。"},"scope":"resource"},"cmake.mingwSearchDirs":{"type":"array","items":{"type":"string","description":"ディレクトリへのパスです。"},"default":[],"description":"MinGW がインストールされる可能性のあるディレクトリです。","scope":"window","markdownDeprecationMessage":"**Deprecated**: Please use `#cmake.additionalCompilerSearchDirs#` instead."},"cmake.additionalCompilerSearchDirs":{"type":"array","items":{"type":"string","description":"ディレクトリへのパスです。"},"default":[],"description":"コンパイラを検索する追加のディレクトリ。","scope":"window"},"cmake.emscriptenSearchDirs":{"type":"array","items":{"type":"string","description":"ディレクトリへのパスです。"},"default":[],"description":"Emscripten がインストールされる可能性のあるディレクトリです。","scope":"window"},"cmake.mergedCompileCommands":{"type":"string","default":null,"description":"cmake.buildDirectory で見つかったすべての compile_commands.json を再帰的に収集してマージします。","scope":"resource"},"cmake.copyCompileCommands":{"type":"string","default":null,"description":"構成が正常に完了したら、compile_commands.json をこの場所にコピーします。","scope":"resource"},"cmake.configureOnOpen":{"type":"boolean","default":true,"description":"CMake プロジェクト ディレクトリを開いたときに自動的に構成します。","scope":"resource"},"cmake.configureOnEdit":{"type":"boolean","default":true,"description":"cmake.sourceDirectory または CMakeLists.txt のコンテンツの保存時に、CMake プロジェクトのディレクトリを自動的に構成します。","scope":"resource"},"cmake.deleteBuildDirOnCleanConfigure":{"type":"boolean","default":false,"description":"クリーン構成が呼び出されたときに、ビルド ディレクトリ全体を削除します。","scope":"resource"},"cmake.setBuildTypeOnMultiConfig":{"type":"boolean","default":false,"description":"マルチ構成ジェネレーターでも CMAKE_BUILD_TYPE を設定します。","scope":"resource"},"cmake.skipConfigureIfCachePresent":{"type":"boolean","default":null,"description":"キャッシュが存在する場合は、構成プロセスをスキップします。","scope":"resource"},"cmake.cmakeCommunicationMode":{"type":"string","default":"automatic","enum":["legacy","serverApi","fileApi","automatic"],"description":"拡張機能と CMake の間の通信に使用されるプロトコル。","scope":"resource"},"cmake.showSystemKits":{"type":"boolean","default":true,"description":"キットの選択にシステム キットを含める。","scope":"resource"},"cmake.ignoreKitEnv":{"type":"boolean","default":false,"description":"CMake コマンドの実行時には、キットの環境変数を使用しないでください。","scope":"resource"},"cmake.buildTask":{"type":"boolean","default":false,"description":"内部プロセスではなく tasks.json を使用してビルドします。","scope":"resource"},"cmake.outputLogEncoding":{"type":"string","default":"auto","description":"外部コマンドからの出力のエンコードです (例: cmake -- build)。","scope":"window"},"cmake.enableTraceLogging":{"type":"boolean","default":false,"description":"ファイルおよびコンソールへのトレース ログを有効にします (非常に煩雑になります)。","scope":"window"},"cmake.loggingLevel":{"type":"string","default":"info","description":"どの種類のメッセージをコンソールに記録する必要があるかを指定します。","enum":["trace","debug","info","note","warning","error","fatal"],"scope":"window"},"cmake.touchbar.visibility":{"type":"string","default":"default","description":"拡張機能によってボタンが MacBook の Touch Bar にどのように表示されるかを構成します。","enum":["default","hidden"],"enumDescriptions":["サポートされているシステムで Touch Bar ボタンを表示します。","Touch Bar ボタンを表示しません。"],"scope":"window"},"cmake.touchbar.advanced":{"type":"object","scope":"window","description":"拡張機能によってボタンが MacBook の Touch Bar にどのように表示されるか詳細設定を構成します。","properties":{"build":{"type":"string","default":"default","description":"拡張機能によってボタンが MacBook の Touch Bar にどのように表示されるかを構成します。","enum":["default","hidden"],"enumDescriptions":["サポートされているシステムで Touch Bar ボタンを表示します。","Touch Bar ボタンを表示しません。"]},"configure":{"type":"string","default":"default","description":"拡張機能によってボタンが MacBook の Touch Bar にどのように表示されるかを構成します。","enum":["default","hidden"],"enumDescriptions":["サポートされているシステムで Touch Bar ボタンを表示します。","Touch Bar ボタンを表示しません。"]},"debug":{"type":"string","default":"default","description":"拡張機能によってボタンが MacBook の Touch Bar にどのように表示されるかを構成します。","enum":["default","hidden"],"enumDescriptions":["サポートされているシステムで Touch Bar ボタンを表示します。","Touch Bar ボタンを表示しません。"]},"launch":{"type":"string","default":"default","description":"拡張機能によってボタンが MacBook の Touch Bar にどのように表示されるかを構成します。","enum":["default","hidden"],"enumDescriptions":["サポートされているシステムで Touch Bar ボタンを表示します。","Touch Bar ボタンを表示しません。"]}}},"cmake.showConfigureWithDebuggerNotification":{"type":"boolean","default":true,"description":"失敗した構成時に CMake デバッガーを使用して構成するかどうかをユーザーに確認するポップアップを有効にします。","scope":"application"},"cmake.showNotAllDocumentsSavedQuestion":{"type":"boolean","default":true,"description":"一部のファイルが保存されていない可能性があるにもかかわらず、ビルドを続行するかどうかをユーザーに確認するポップアップを有効にします。有効にしない場合、ビルドは続行されます。","scope":"application"},"cmake.options.statusBarVisibility":{"type":"string","default":"hidden","markdownDescription":"拡張機能によってオプションがステータス バーにどのように表示されるかを構成します。これらの設定は、より具体的な `#cmake.options.advanced.statusBarVisibility#` 設定によって上書きされる可能性があります。[詳細情報](https://aka.ms/cmaketoolsoptionsconfiguration)。","enum":["visible","compact","icon","hidden"],"scope":"window"},"cmake.options.advanced":{"type":"object","default":{"build":{"statusBarVisibility":"inherit","inheritDefault":"visible"},"launch":{"statusBarVisibility":"inherit","inheritDefault":"visible"},"debug":{"statusBarVisibility":"inherit","inheritDefault":"visible"}},"markdownDescription":"個々のプロジェクト状態ビューとステータス バー オプションの設定を構成します。これらの設定により、より一般的な `#cmake.options.statusBarVisibility#` 設定が上書きされる可能性があります。[詳細情報](https://aka.ms/cmaketoolsoptionsconfiguration)。","properties":{"configure":{"type":"object","properties":{"projectStatusVisibility":{"type":"string","description":"拡張機能がこのオプションをプロジェクト状態ビューに表示する方法を構成します。","enum":["visible","hidden"],"enumDescriptions":["ノードをプロジェクト状態ビューに表示します。","プロジェクト状態ビューでノードとその子を非表示にします。"]}}},"configurePreset":{"type":"object","properties":{"statusBarVisibility":{"type":"string","markdownDescription":"個々のステータス バー オプションの設定を構成します。これらの設定により、より一般的な `#cmake.options.statusBarVisibility#` 設定が上書きされます。","enum":["visible","compact","icon","hidden","inherit"],"markdownEnumDescriptions":["ステータス バー オプションをフル サイズで表示します。","ステータス バー オプションのアイコンのみを表示します。","テキストが `#cmake.status.advanced.statusBarLength#` で指定された長さに切り捨てられたステータス バー オプションを表示します (既定値は 20)。","ステータス バー オプションを非表示にします。","より一般的な `#cmake.options.statusBarVisibility#` 設定が `hidden` に設定されている場合、既定では `#cmake.options.advanced.inheritDefault#` 設定で設定されているものに設定されます。それ以外の場合は、`#cmake.options.statusBarVisibility#` 設定が継承されます。"]},"inheritDefault":{"type":"string","markdownDescription":"`#cmake.options.statusBarVisibility#` が `hidden` に設定されている場合の、`#cmake.options.advanced.statusBarVisibility#` 設定の `inherit` オプションの既定値を構成します。これは、`#cmake.options.advanced.statusBarVisibility#` 設定と同じオプションから `inherit` オプションを差し引いたオプションを持っています。","enum":["visible","compact","icon","hidden"]},"statusBarLength":{"description":"`compact` モードに設定したときにステータス バーに表示されるテキストの最大長を構成します。","type":"integer","default":20}}},"buildPreset":{"type":"object","properties":{"statusBarVisibility":{"type":"string","markdownDescription":"個々のステータス バー オプションの設定を構成します。これらの設定により、より一般的な `#cmake.options.statusBarVisibility#` 設定が上書きされます。","enum":["visible","compact","icon","hidden","inherit"],"markdownEnumDescriptions":["ステータス バー オプションをフル サイズで表示します。","ステータス バー オプションのアイコンのみを表示します。","テキストが `#cmake.status.advanced.statusBarLength#` で指定された長さに切り捨てられたステータス バー オプションを表示します (既定値は 20)。","ステータス バー オプションを非表示にします。","より一般的な `#cmake.options.statusBarVisibility#` 設定が `hidden` に設定されている場合、既定では `#cmake.options.advanced.inheritDefault#` 設定で設定されているものに設定されます。それ以外の場合は、`#cmake.options.statusBarVisibility#` 設定が継承されます。"]},"inheritDefault":{"type":"string","markdownDescription":"`#cmake.options.statusBarVisibility#` が `hidden` に設定されている場合の、`#cmake.options.advanced.statusBarVisibility#` 設定の `inherit` オプションの既定値を構成します。これは、`#cmake.options.advanced.statusBarVisibility#` 設定と同じオプションから `inherit` オプションを差し引いたオプションを持っています。","enum":